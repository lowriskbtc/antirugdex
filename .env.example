# Copy to .env and fill in.
#
# 🔴 EVERY NAME IS CLUSTER-SUFFIXED. Never add a bare, un-suffixed one.
# CLUSTER is the single switch and it moves the RPC, both keypairs and the
# treasury together. Before that, a .env set to mainnet handed mainnet keys and
# a mainnet RPC to runs that logged "devnet" — and CLUSTER=devnet was itself
# what disabled mainnetGuard. lib.ts now verifies the RPC's GENESIS HASH
# against CLUSTER, which a URL string cannot fake, but a bare name would still
# read as a fallback in code that expects a suffix.

# devnet | mainnet
CLUSTER=devnet

# Devnet is fine on the public RPC. For mainnet use Helius/Triton — the public
# endpoint will rate-limit you out of your own launch. Note that fee collection
# also needs an RPC that permits getProgramAccounts, which the public one does
# NOT (Token-2022 is excluded from its secondary indexes).
RPC_URL_DEVNET=https://api.devnet.solana.com
RPC_URL_MAINNET=

# Path to a solana-keygen JSON keypair. Generate with:
#   solana-keygen new -o ./deployer-devnet.json
# or, without the Solana CLI installed:
#   npx tsx src/00-keygen.ts ./deployer-devnet.json
DEPLOYER_KEYPAIR_DEVNET=./deployer-devnet.json
DEPLOYER_KEYPAIR_MAINNET=./deployer-mainnet.json

# Address that becomes withdrawWithheldAuthority AND owns the account collected
# fees land in. Set at mint creation and never changed by 05. Leave blank to use
# the deployer.
#
# IT MUST BE ABLE TO PRODUCE A SIGNATURE. Two shapes work:
#   1. A plain keypair you hold  -> set WITHHELD_AUTHORITY_KEYPAIR below
#   2. A Token-2022 NATIVE multisig (spl-token create-multisig)
#                                -> set WITHHELD_MULTISIG_SIGNERS below
#
# A SQUADS VAULT DOES NOT WORK. It is a PDA with no private key and signs only
# via CPI from the Squads program, so 04-harvest.ts can never complete the
# withdraw step — fees would harvest onto the mint and strand there permanently.
# For Squads custody, use a cold keypair here and forward collected tokens to
# the vault afterwards.
TREASURY_PUBKEY_DEVNET=
TREASURY_PUBKEY_MAINNET=

# Needed when TREASURY_PUBKEY is a plain keypair that differs from the deployer.
# WITHHELD_AUTHORITY_KEYPAIR_DEVNET=./treasury-devnet.json
# WITHHELD_AUTHORITY_KEYPAIR_MAINNET=./treasury-mainnet.json

# Needed when TREASURY_PUBKEY is a Token-2022 native multisig. Comma-separated
# member keypair paths, enough of them to meet the threshold.
# WITHHELD_MULTISIG_SIGNERS_DEVNET=./m1.json,./m2.json
# WITHHELD_MULTISIG_SIGNERS_MAINNET=./m1.json,./m2.json

# Set to "yes" to also freeze name/symbol/uri and the metadata pointer when
# running `npm run lock`. Only once the URI is final and permanently hosted.
# REVOKE_METADATA_AUTHORITY=yes
